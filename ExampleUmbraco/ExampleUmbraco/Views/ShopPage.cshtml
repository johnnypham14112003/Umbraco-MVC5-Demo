@inherits Umbraco.Web.Mvc.UmbracoTemplatePage
@using Service.ViewModels
@using Umbraco.Web.Models
@using Newtonsoft.Json.Linq
@{
    Layout = "Layout.cshtml";

    // For read param type from URL
    string viewType = Request.QueryString["type"];

    var motors = ViewBag.MotorList as IEnumerable<MotorViewModel>;
    bool isMotor = true;

    if (!string.IsNullOrEmpty(viewType) && viewType.ToLower() == "clothes")
    {
        isMotor = false;
    }

    var cateProp = Model.Content.GetProperty("listCategory");
    var listCategoriesRaw = (cateProp != null && cateProp.DataValue != null) ? cateProp.DataValue.ToString() : "";
    JArray cateArray = !string.IsNullOrWhiteSpace(listCategoriesRaw) ? JArray.Parse(listCategoriesRaw) : new JArray();

    var filterProp = Model.Content.GetProperty("listFilter");
    var lisFiltersRaw = (filterProp != null && filterProp.DataValue != null) ? filterProp.DataValue.ToString() : "";
    JArray filterArray = !string.IsNullOrWhiteSpace(lisFiltersRaw) ? JArray.Parse(lisFiltersRaw) : new JArray();

    var brandImgs = Model.Content.GetPropertyValue<IEnumerable<IPublishedContent>>("shoppageBrandImages");
}
<style>
    .showroom-header {
    background-color: #111;
    color: white;
    padding: 50px 0;
    margin-bottom: 40px;
    text-align: center;
    border-bottom: 5px solid #FF0000;
    }
    .motor-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: 8px;
    overflow: hidden;
    }
    .motor-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
    }
    .motor-img-container {
    height: 250px;
    background-color: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    }
    .motor-img-container img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    }
    .motor-name {
    font-weight: 800;
    letter-spacing: 1px;
    font-size: 1.4rem;
    }
    .motor-price {
    color: #66cc33;
    font-weight: 700;
    font-size: 1.2rem;
    }
    .motor-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.9rem;
    }
    .search-bar-wrapper {
    max-width: 700px;
    margin: 0 auto 40px auto;
    }
</style>
<div class="container py-5">
    <div class="row">
        <div class="col-lg-3">
            <h1 class="h2 pb-4">@Umbraco.Field("categories")</h1>
            <ul class="list-unstyled templatemo-accordion">
                @foreach (JToken item in cateArray)
                {
                    var caption = item["caption"] != null ? item["caption"].ToString() : "";
                    var link = item["link"] != null ? item["link"].ToString() : "";
                    var isInternal = item["isInternal"] != null ? item["isInternal"].ToObject<bool>() : false;
                    var newWindow = item["newWindow"] != null ? item["newWindow"].ToObject<bool>() : false;
                    var target = newWindow ? "_blank" : "_self";
                    var finalUrl = link;

                    if (isInternal && !string.IsNullOrEmpty(link))
                    {
                        var targetNode = Umbraco.TypedContent(link);
                        if (targetNode != null) { finalUrl = targetNode.Url; }
                    }

                    <li class="pb-3">
                        <a class="collapsed d-flex justify-content-between h3 text-decoration-none" href="@finalUrl" target="@target"
                        onclick="window.location.href=this.href;">
                            @caption<i class="fa fa-fw fa-chevron-circle-down mt-1"></i>
                        </a>
                        <ul class="collapse show list-unstyled pl-3">
                            <li><a class="text-decoration-none" href="#">Subcategory 1</a></li>
                            <li><a class="text-decoration-none" href="#">Subcategory 2</a></li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
        <div class="col-lg-9">
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-inline shop-top-menu pb-3 pt-1">
                        @foreach (JToken item in filterArray)
                        {
                            var caption = item["caption"] != null ? item["caption"].ToString() : "";
                            var link = item["link"] != null ? item["link"].ToString() : "";
                            var isInternal = item["isInternal"] != null ? item["isInternal"].ToObject<bool>() : false;
                            var newWindow = item["newWindow"] != null ? item["newWindow"].ToObject<bool>() : false;
                            var target = newWindow ? "_blank" : "_self";
                            var finalUrl = link;

                            if (isInternal && !string.IsNullOrEmpty(link))
                            {
                                var targetNode = Umbraco.TypedContent(link);
                                if (targetNode != null) { finalUrl = targetNode.Url; }
                            }
                            <li class="list-inline-item">
                                <a class="h3 text-dark text-decoration-none mr-3" href="@finalUrl" target="@target"/>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-md-6 pb-4">
                    <div class="d-flex">
                        <select class="form-control">
                            <option>Featured</option>
                            <option>A to Z</option>
                            <option>Item</option>
                        </select>
                    </div>
                </div>
            </div>
            
            @if(isMotor == false){
                @Html.Partial("ShopClothesList")
            } else {
            <main class="container mb-5">
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
                    @if (motors != null && motors.Any()){
                        foreach (var item in motors)
                        {
                            <div class="col">
                                <div class="card h-100 border-1 shadow-sm motor-card">
                                    <div class="motor-img-container">
                                        @if (string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="~/wwwroot/icons/black-moto.png" alt="motor image" />
                                        }
                                        else
                                        {
                                            <img src="@Html.DisplayFor(modelItem => item.ImageUrl)" alt="motor image" />
                                        }
                                    </div>
                                    <div class="card-body d-flex flex-column text-center">
                                        <h2 class="card-title text-uppercase motor-name mb-1">
                                            @Html.DisplayFor(modelItem => item.Name)
                                        </h2>
                                        <div class="mb-3">
                                            <span class="motor-price">@Html.DisplayFor(modelItem => item.Price) VNĐ</span>
                                        </div>
                                        <p class="card-text text-muted motor-desc">
                                            @Html.DisplayFor(modelItem => item.Description)
                                        </p>
                                        <div class="mt-auto pt-3">
                                            @Html.ActionLink("DETAILS", "DetailMotor", "Home", new { id = item.Id }, new { @class = "btn btn-outline-dark w-100 fw-bold rounded-pill" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    } else
                    { <div>Not found any data!</div>
                    }
                </div>
            </main>
            }
            
            <div div="row">
                <ul class="pagination pagination-lg justify-content-end">
                    <li class="page-item disabled">
                        <a class="page-link active rounded-0 mr-3 shadow-sm border-top-0 border-left-0" href="#" tabindex="-1">1</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link rounded-0 mr-3 shadow-sm border-top-0 border-left-0 text-dark" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link rounded-0 shadow-sm border-top-0 border-left-0 text-dark" href="#">3</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Content -->
<!-- Start Brands -->
<section class="bg-light py-5">
    <div class="container my-4">
        <div class="row text-center py-3">
            <div class="col-lg-6 m-auto">
                <h1 class="h1">@Umbraco.Field("shoppageBrandSection")</h1>
                <p>@Umbraco.Field("shoppageBrandSectionDescription")</p>
            </div>
            <div class="col-lg-9 m-auto tempaltemo-carousel">
                <div class="row d-flex flex-row">
                    <!--Controls-->
                    <div class="col-1 align-self-center">
                        <a class="h1" href="#multi-item-example" role="button" data-bs-slide="prev">
                        <i class="text-light fas fa-chevron-left"></i>
                        </a>
                    </div>
                    <!--End Controls-->
                    <!--Carousel Wrapper-->
                    <div class="col">
                        <div class="carousel slide carousel-multi-item pt-2 pt-md-0" id="multi-item-example" data-bs-ride="carousel">
                            <!--Slides-->
                            <div class="carousel-inner product-links-wap" role="listbox">
                                <!--First slide-->
                                @if (brandImgs != null && brandImgs.Any())
                                {
                                <div class="carousel-item active">
                                    <div class="row">
                                        @foreach (var image in brandImgs)
                                        {
                                        <div class="col-3 p-md-5">
                                            <a href="#"><img class="img-fluid brand-img" src="@image.Url" alt="@image.Name" /></a>
                                        </div>
                                        }
                                    </div>
                                </div>
                                }
                                <!--End First slide-->
                                <!--Second slide-->
                                @if (brandImgs != null && brandImgs.Any())
                                {
                                <div class="carousel-item">
                                    <div class="row">
                                        @foreach (var image in brandImgs)
                                        {
                                        <div class="col-3 p-md-5">
                                            <a href="#"><img class="img-fluid brand-img" src="@image.Url" alt="@image.Name" /></a>
                                        </div>
                                        }
                                    </div>
                                </div>
                                }
                                <!--End Second slide-->
                            </div>
                            <!--End Slides-->
                        </div>
                    </div>
                    <!--End Carousel Wrapper-->
                    <!--Controls-->
                    <div class="col-1 align-self-center">
                        <a class="h1" href="#multi-item-example" role="button" data-bs-slide="next">
                        <i class="text-light fas fa-chevron-right"></i>
                        </a>
                    </div>
                    <!--End Controls-->
                </div>
            </div>
        </div>
    </div>
</section>
<!--End Brands-->