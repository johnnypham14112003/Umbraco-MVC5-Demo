@inherits Umbraco.Web.Mvc.UmbracoTemplatePage
@{
    Layout = "Layout.cshtml";
    
    // Query all child node data
    var sections = Model.Content.Children.Where(x => x.IsVisible());
}

@foreach (var section in sections)
{
    switch (section.DocumentTypeAlias)
    {
        case "homePageSection1":
            @Html.Partial("HomePageNested/HomePageSection1", section)
            break;
            
        case "homePageSection2":
            @Html.Partial("HomePageNested/HomePageSection2", section)
            break;
            
        case "homePageSection3":
            @Html.Partial("HomePageNested/HomePageSection3", section)
            break;
        case "homePageSection4":
            @Html.Partial("HomePageNested/HomePageSection4", section)
            break;
    }
}