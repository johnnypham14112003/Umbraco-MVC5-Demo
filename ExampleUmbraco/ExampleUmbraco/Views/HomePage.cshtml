@inherits Umbraco.Web.Mvc.UmbracoTemplatePage
@using Umbraco.Web.Models
@using Newtonsoft.Json.Linq
@{
    Layout = "Layout.cshtml";
    var banner1Img = Model.Content.GetPropertyValue<IPublishedContent>("banner1Image");
    var banner2Img = Model.Content.GetPropertyValue<IPublishedContent>("banner2Image");
    var banner3Img = Model.Content.GetPropertyValue<IPublishedContent>("banner3Image");
    
    var category1Img = Model.Content.GetPropertyValue<IPublishedContent>("category1Image");
    var category2Img = Model.Content.GetPropertyValue<IPublishedContent>("category2Image");
    var category3Img = Model.Content.GetPropertyValue<IPublishedContent>("category3Image");
    
    var feature1Img = Model.Content.GetPropertyValue<IPublishedContent>("feature1Image");
    var feature2Img = Model.Content.GetPropertyValue<IPublishedContent>("feature2Image");
    var feature3Img = Model.Content.GetPropertyValue<IPublishedContent>("feature3Image");
}
    <!-- Start Banner Hero -->
    <div id="template-mo-zay-hero-carousel" class="carousel slide" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            <li data-bs-target="#template-mo-zay-hero-carousel" data-bs-slide-to="0" class="active"></li>
            <li data-bs-target="#template-mo-zay-hero-carousel" data-bs-slide-to="1"></li>
            <li data-bs-target="#template-mo-zay-hero-carousel" data-bs-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="container">
                    <div class="row p-5">
                        <div class="mx-auto col-md-8 col-lg-6 order-lg-last">
                            <img class="img-fluid" src="@(banner1Img != null ? banner1Img.Url : "")" alt="">
                        </div>
                        <div class="col-lg-6 mb-0 d-flex align-items-center">
                            <div class="text-align-left align-self-center">
                                <h1 class="h1 text-success"><b>@Umbraco.Field("brandName")</b> - @Umbraco.Field("banner1MainTitle")</h1>
                                <h3 class="h2">@Umbraco.Field("banner1SubTitle")</h3>
                                <p>
                                    @Umbraco.Field("banner1Description")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="container">
                    <div class="row p-5">
                        <div class="mx-auto col-md-8 col-lg-6 order-lg-last">
                            <img class="img-fluid" src="@(banner2Img != null ? banner2Img.Url : "")" alt="">
                        </div>
                        <div class="col-lg-6 mb-0 d-flex align-items-center">
                            <div class="text-align-left">
                                <h1 class="h1">@Umbraco.Field("banner2MainTitle")</h1>
                                <h3 class="h2">@Umbraco.Field("banner2SubTitle")</h3>
                                <p>
                                    @Umbraco.Field("banner2Description")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="container">
                    <div class="row p-5">
                        <div class="mx-auto col-md-8 col-lg-6 order-lg-last">
                            <img class="img-fluid" src="@(banner3Img != null ? banner3Img.Url : "")" alt="">
                        </div>
                        <div class="col-lg-6 mb-0 d-flex align-items-center">
                            <div class="text-align-left">
                                <h1 class="h1">@Umbraco.Field("banner3MainTitle")</h1>
                                <h3 class="h2">@Umbraco.Field("banner3SubTitle")</h3>
                                <p>
                                    @Umbraco.Field("banner3Description")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev text-decoration-none w-auto ps-3" href="#template-mo-zay-hero-carousel" role="button" data-bs-slide="prev">
            <i class="fas fa-chevron-left"></i>
        </a>
        <a class="carousel-control-next text-decoration-none w-auto pe-3" href="#template-mo-zay-hero-carousel" role="button" data-bs-slide="next">
            <i class="fas fa-chevron-right"></i>
        </a>
    </div>
    <!-- End Banner Hero -->


    <!-- Start Categories of The Month -->
    <section class="container py-5">
        <div class="row text-center pt-3">
            <div class="col-lg-6 m-auto">
                <h1 class="h1">@Umbraco.Field("titleCategory")</h1>
                <p>@Umbraco.Field("descriptionCategory")</p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-4 p-5 mt-3">
                <a href="#"><img src="@(category1Img != null ? category1Img.Url : "")" class="rounded-circle img-fluid border"></a>
                <h5 class="text-center mt-3 mb-3">@Umbraco.Field("category1Name")</h5>
                <p class="text-center"><a class="btn btn-success">Go Shop</a></p>
            </div>
            <div class="col-12 col-md-4 p-5 mt-3">
                <a href="#"><img src="@(category2Img != null ? category2Img.Url : "")" class="rounded-circle img-fluid border"></a>
                <h2 class="h5 text-center mt-3 mb-3">@Umbraco.Field("category2Name")</h2>
                <p class="text-center"><a class="btn btn-success">Go Shop</a></p>
            </div>
            <div class="col-12 col-md-4 p-5 mt-3">
                <a href="#"><img src="@(category3Img != null ? category3Img.Url : "")" class="rounded-circle img-fluid border"></a>
                <h2 class="h5 text-center mt-3 mb-3">@Umbraco.Field("category3Name")</h2>
                <p class="text-center"><a class="btn btn-success">Go Shop</a></p>
            </div>
        </div>
    </section>
    <!-- End Categories of The Month -->


    <!-- Start Featured Product -->
    <section class="bg-light">
        <div class="container py-5">
            <div class="row text-center py-3">
                <div class="col-lg-6 m-auto">
                    <h1 class="h1">@Umbraco.Field("titleFeature")</h1>
                    <p>@Umbraco.Field("descriptionFeature")</p>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-4 mb-4">
                    <div class="card h-100">
                        <a href="shop-single.html">
                            <img src="@(feature1Img != null ? feature1Img.Url : "")" class="card-img-top" alt="...">
                        </a>
                        <div class="card-body">
                            <ul class="list-unstyled d-flex justify-content-between">
                                <li>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-muted fa fa-star"></i>
                                    <i class="text-muted fa fa-star"></i>
                                </li>
                                <li class="text-muted text-right">@Umbraco.Field("feature1Price")</li>
                            </ul>
                            <a href="shop-single.html" class="h2 text-decoration-none text-dark">@Umbraco.Field("feature1Name")</a>
                            <p class="card-text">@Umbraco.Field("feature1Description")</p>
                            <p class="text-muted">@Umbraco.Field("feature1Review")</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 mb-4">
                    <div class="card h-100">
                        <a href="shop-single.html">
                            <img src="@(feature2Img != null ? feature2Img.Url : "")" class="card-img-top" alt="...">
                        </a>
                        <div class="card-body">
                            <ul class="list-unstyled d-flex justify-content-between">
                                <li>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-muted fa fa-star"></i>
                                    <i class="text-muted fa fa-star"></i>
                                </li>
                                <li class="text-muted text-right">@Umbraco.Field("feature2Price")</li>
                            </ul>
                            <a href="shop-single.html" class="h2 text-decoration-none text-dark">@Umbraco.Field("feature2Name")</a>
                            <p class="card-text">@Umbraco.Field("feature2Description")</p>
                            <p class="text-muted">@Umbraco.Field("feature2Review")</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 mb-4">
                    <div class="card h-100">
                        <a href="shop-single.html">
                            <img src="@(feature3Img != null ? feature3Img.Url : "")" class="card-img-top" alt="...">
                        </a>
                        <div class="card-body">
                            <ul class="list-unstyled d-flex justify-content-between">
                                <li>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                    <i class="text-warning fa fa-star"></i>
                                </li>
                                <li class="text-muted text-right">@Umbraco.Field("feature3Price")</li>
                            </ul>
                            <a href="shop-single.html" class="h2 text-decoration-none text-dark">@Umbraco.Field("feature3Name")</a>
                            <p class="card-text">@Umbraco.Field("feature3Description")</p>
                            <p class="text-muted">@Umbraco.Field("feature3Review")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End Featured Product -->