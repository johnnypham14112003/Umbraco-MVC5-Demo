@inherits Umbraco.Web.Mvc.UmbracoTemplatePage
@using Umbraco.Web.Models
@using Newtonsoft.Json.Linq
@{
    Layout = "Layout.cshtml";
    
     var nestedItems = Model.Content.GetPropertyValue<IEnumerable<IPublishedContent>>("sectionContentManagement");
}

@if (nestedItems != null && nestedItems.Any())
{
    foreach (var item in nestedItems)
    {
        @Html.Partial("~/Views/Partials/HomePageNested/" + item.DocumentTypeAlias + ".cshtml", item)
    }
}