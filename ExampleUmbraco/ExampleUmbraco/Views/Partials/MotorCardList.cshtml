@model List<Service.ViewModels.MotorViewModel>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 border-1 shadow-sm motor-card">
                <div class="motor-img-container">
                    @if (string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="../Content/black-moto.png" alt="motor image" />
                    }
                    else
                    {
                        <img src="@Html.DisplayFor(modelItem => item.ImageUrl)" alt="motor image" />
                    }
                </div>
                <div class="card-body d-flex flex-column text-center">
                    <h2 class="card-title text-uppercase motor-name mb-1">
                        @Html.DisplayFor(modelItem => item.Name)
                    </h2>
                    <div class="mb-3">
                        <span class="motor-price">@Html.DisplayFor(modelItem => item.Price) VNĐ</span>
                    </div>
                    <p class="card-text text-muted motor-desc">
                        @Html.DisplayFor(modelItem => item.Description)
                    </p>
                    <div class="mt-auto pt-3">
                        <div class="d-flex justify-content-between">
                            <!-- Button Edit -->
                            <button type="button" class="btn btn-sm btn-primary w-50 me-1" data-bs-toggle="modal" data-bs-target="#editMotorModal-@item.Id">
                                Edit
                            </button>

                            <!-- Button Delete -->
                            @using (Html.BeginUmbracoForm("DeleteMotor", "MotorSurface", new { id = item.Id }, new { @class = "w-50 ms-1", onsubmit = "return confirm('Confirm delete this motor?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger w-100">Delete</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Edit for each Motor -->
        <div class="modal fade" id="editMotorModal-@item.Id" tabindex="-1" aria-labelledby="editModalLabel-@item.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    @using (Html.BeginUmbracoForm("UpdateMotor", "MotorSurface", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="editModalLabel-@item.Id">Edit Motor</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="Id" value="@item.Id" />
                            <div class="mb-3">
                                <label class="form-label">Name Motor</label>
                                <input type="text" class="form-control" name="Name" value="@item.Name" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Price (VNĐ)</label>
                                <input type="number" class="form-control" name="Price" value="@item.Price" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="Description" rows="3">@item.Description</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">URL Image</label>
                                <input type="text" class="form-control" name="ImageUrl" value="@item.ImageUrl" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{ <div>Not found any data!</div>}