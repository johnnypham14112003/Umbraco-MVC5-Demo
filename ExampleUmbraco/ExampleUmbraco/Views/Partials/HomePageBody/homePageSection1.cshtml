@inherits Umbraco.Web.Mvc.UmbracoTemplatePage<IPublishedContent>
@using Our.Umbraco.Vorto.Extensions
<!-- vvv For Mapping vvv -->
@using Service.ViewModels.UmbracoContent
@using ExampleUmbraco.Extension
@{
    // Query all child node data
    var childNodes = Model.Content.Children.Where(x => x.IsVisible());
    
    List<BannerItemModel> bannerItems = childNodes.ContentMapToList<BannerItemModel>();
}

@if (bannerItems.Any())
{
<!-- Start Banner Hero -->
    <div id="template-mo-zay-hero-carousel" class="carousel slide" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            @for(int i = 0; i < bannerItems.Count; i++){
                var isActive = (i == 0) ? "active" : null;
                <li data-bs-target="#template-mo-zay-hero-carousel" data-bs-slide-to="@i" class="@isActive"></li>
            }
        </ol>
        <div class="carousel-inner">
            @for(int i = 0; i < bannerItems.Count; i++)
            {
                var currentItem = bannerItems[i];
                var isActive = (i == 0) ? "active" : null;
                <div class="carousel-item @isActive">
                    <div class="container">
                        <div class="row p-5">
                            <div class="mx-auto col-md-8 col-lg-6 order-lg-last">
                                <img class="img-fluid" src="@currentItem.BannerImage" alt="">
                            </div>
                            <div class="col-lg-6 mb-0 d-flex align-items-center">
                                <div class="text-align-left align-self-center">
                                    <h1 class="h1 text-success">@currentItem.BannerTitle</h1>
                                    <h3 class="h2">@currentItem.BannerSubtitle</h3>
                                    <p>@currentItem.BannerSummary</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <a class="carousel-control-prev text-decoration-none w-auto ps-3" href="#template-mo-zay-hero-carousel" role="button" data-bs-slide="prev">
            <i class="fas fa-chevron-left"></i>
        </a>
        <a class="carousel-control-next text-decoration-none w-auto pe-3" href="#template-mo-zay-hero-carousel" role="button" data-bs-slide="next">
            <i class="fas fa-chevron-right"></i>
        </a>
    </div>
    <!-- End Banner Hero -->
    }