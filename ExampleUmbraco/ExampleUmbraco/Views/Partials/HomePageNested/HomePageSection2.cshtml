@inherits Umbraco.Web.Mvc.UmbracoTemplatePage<IPublishedContent>
@using Umbraco.Web.Models
@using Newtonsoft.Json.Linq
@{
    var category1Img = Model.Content.GetPropertyValue<IPublishedContent>("category1Image");
    var category2Img = Model.Content.GetPropertyValue<IPublishedContent>("category2Image");
    var category3Img = Model.Content.GetPropertyValue<IPublishedContent>("category3Image");
}

<!-- Start Categories of The Month -->
    <section class="container py-5">
        <div class="row text-center pt-3">
            <div class="col-lg-6 m-auto">
                <h1 class="h1">@Umbraco.Field("titleCategory")</h1>
                <p>@Umbraco.Field("descriptionCategory")</p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-4 p-5 mt-3">
                <a href="#"><img src="@(category1Img != null ? category1Img.Url : "")" class="rounded-circle img-fluid border"></a>
                <h5 class="text-center mt-3 mb-3">@Umbraco.Field("category1Name")</h5>
                <p class="text-center"><a class="btn btn-success">Go Shop</a></p>
            </div>
            <div class="col-12 col-md-4 p-5 mt-3">
                <a href="#"><img src="@(category2Img != null ? category2Img.Url : "")" class="rounded-circle img-fluid border"></a>
                <h2 class="h5 text-center mt-3 mb-3">@Umbraco.Field("category2Name")</h2>
                <p class="text-center"><a class="btn btn-success">Go Shop</a></p>
            </div>
            <div class="col-12 col-md-4 p-5 mt-3">
                <a href="#"><img src="@(category3Img != null ? category3Img.Url : "")" class="rounded-circle img-fluid border"></a>
                <h2 class="h5 text-center mt-3 mb-3">@Umbraco.Field("category3Name")</h2>
                <p class="text-center"><a class="btn btn-success">Go Shop</a></p>
            </div>
        </div>
    </section>
<!-- End Categories of The Month -->