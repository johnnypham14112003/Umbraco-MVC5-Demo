@inherits Umbraco.Web.Mvc.UmbracoTemplatePage<IPublishedContent>
@{
    // Query all child node data
    var productItems = Model.Content.Children.Where(x => x.IsVisible()).ToList();
}

<!-- Start Categories of The Month -->
    <section class="container py-5">
        <div class="row text-center pt-3">
            <div class="col-lg-6 m-auto">
                <h1 class="h1">@Umbraco.Field("homeSection2Title")</h1>
                <p>@Umbraco.Field("homeSection2Description")</p>
            </div>
        </div>
        <div class="row">
            @foreach(var item in productItems){
                var productImg = item.GetPropertyValue<IPublishedContent>("productImage");
                
                <div class="col-12 col-md-4 p-5 mt-3">
                    <a href="#"><img src="@(productImg != null ? productImg.Url : "")" class="rounded-circle img-fluid border"></a>
                    <h5 class="text-center mt-3 mb-3">@item.GetPropertyValue("productName")</h5>
                    <p class="text-center"><a class="btn btn-success">Go Shop</a></p>
                </div>
            }
        </div>
    </section>
<!-- End Categories of The Month -->