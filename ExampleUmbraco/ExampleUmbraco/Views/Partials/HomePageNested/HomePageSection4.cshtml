@inherits Umbraco.Web.Mvc.UmbracoTemplatePage<IPublishedContent>
@{
    // Query all child node data
    var planItems = Model.Content.Children.Where(x => x.IsVisible()).ToList();
}

    <!-- Start Featured Product -->
    <section style="background-color: #f6f5f2; font-family: 'Inter', sans-serif;">
    <div class="container py-5">
        
        <div class="row mb-5">
            <div class="col-12">
                <p class="text-uppercase mb-3" style="color: #c49a5b; font-size: 0.7rem; letter-spacing: 1.5px; font-weight: 600;">
                    @Umbraco.Field("homeSection4Header")
                </p>
                <h1 class="mb-4" style="font-family: 'Playfair Display', serif; font-size: 2.8rem; line-height: 1.2; color: #000;">
                    @Umbraco.Field("homeSection4Title")&nbsp;—&nbsp;
                    <span class="fst-italic" style="color: #c49a5b;">
                        @Umbraco.Field("homeSection4TitleExpand")
                    </span>
                </h1>
                <p style="font-size: 0.95rem; max-width: 650px; line-height: 1.6;">
                    @Umbraco.Field("homeSection4Description")
                </p>
            </div>
        </div>

        <div class="row g-4">
            @foreach(var item in planItems)
            {
                var benefitList = item.GetPropertyValue<IEnumerable<string>>("planBenefitList");
                var planImg = item.GetPropertyValue<IPublishedContent>("planImage");
                
                var planName = item.GetPropertyValue<string>("planName");
                var planTitle = item.GetPropertyValue<string>("planTitle");
                var planSummary = item.GetPropertyValue<string>("planSummary");
                var planAdvance1Title = item.GetPropertyValue<string>("planAdvance1Title");
                var planAdvance1Content = item.GetPropertyValue<string>("planAdvance1Content");
                var planAdvance2Title = item.GetPropertyValue<string>("planAdvance2Title");
                var planAdvance2Content = item.GetPropertyValue<string>("planAdvance2Content");
                var planAdvance3Title = item.GetPropertyValue<string>("planAdvance3Title");
                var planAdvance3Content = item.GetPropertyValue<string>("planAdvance3Content");

                <div class="col-md-4">
                    <div class="card border-0 rounded-0 h-100 shadow-sm d-flex flex-column" style="background-color: #fff;">
                        
                        @if (planImg != null)
                        {
                            <img src="@planImg.Url" class="card-img-top rounded-0 w-100" style="aspect-ratio: 1/1; object-fit: cover;" alt="@planName">
                        }
                        else
                        {
                            <div class="w-100 d-flex align-items-center justify-content-center position-relative" style="height: 250px; background: linear-gradient(135deg, #4a3419, #23160a);">
                                <div class="position-absolute rounded-circle" style="width: 120px; height: 120px; background: radial-gradient(circle, #fcd06b 0%, #a46d23 80%); filter: blur(8px);"></div>
                                <div class="position-relative text-white" style="z-index: 1; font-size: 2rem;">&#9728;</div>
                            </div>
                        }

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <p class="text-uppercase mb-2" style="color: #c49a5b; font-size: 0.7rem; letter-spacing: 1.5px; font-weight: 600;">
                                @planName
                            </p>
                            <h3 class="h4 mb-3" style="font-family: 'Playfair Display', serif; color: #000; line-height: 1.3;">
                                @planTitle
                            </h3>
                            <p class="mb-0" style="font-size: 0.85rem; line-height: 1.6;">
                                @planSummary
                            </p>
                            
                            <hr class="w-100" style="border-color: #e0e0e0; opacity: 1; margin: 1.5rem 0;">
                            
                            <ul class="list-unstyled mb-0 flex-grow-1">
                                @if (benefitList != null && benefitList.Any())
                                {
                                    foreach (var benefit in benefitList)
                                    {
                                        <li class="d-flex align-items-start mb-2" style="font-size: 0.8rem; line-height: 1.5;">
                                            <span class="me-2" style="color: #000; font-size: 0.8rem;">&#10003;</span>
                                            <span>@benefit</span>
                                        </li>
                                    }
                                }
                            </ul>
                            
                            <hr class="w-100" style="border-color: #e0e0e0; opacity: 1; margin: 1.5rem 0;">
                            
                            <div class="d-flex justify-content-between align-items-end w-100">
                                <div class="d-flex flex-column">
                                    <span class="mb-1" style="font-size: 1.2rem; color: #000; font-family: 'Playfair Display', serif; line-height: 1;">@planAdvance1Content</span>
                                    <span class="text-uppercase" style="font-size: 0.6rem; letter-spacing: 1px; line-height: 1.2;">@Html.Raw(planAdvance1Title)</span>
                                </div>
                                <div class="d-flex flex-column">
                                    <span class="mb-1" style="font-size: 1.2rem; color: #000; font-family: 'Playfair Display', serif; line-height: 1;">@planAdvance2Content</span>
                                    <span class="text-uppercase" style="font-size: 0.6rem; letter-spacing: 1px; line-height: 1.2;">@Html.Raw(planAdvance2Title)</span>
                                </div>
                                <div class="d-flex flex-column">
                                    <span class="mb-1" style="font-size: 1.2rem; color: #000; font-family: 'Playfair Display', serif; line-height: 1;">@planAdvance3Content</span>
                                    <span class="text-uppercase" style="font-size: 0.6rem; letter-spacing: 1px; line-height: 1.2;">@Html.Raw(planAdvance3Title)</span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
    <!-- End Featured Product -->