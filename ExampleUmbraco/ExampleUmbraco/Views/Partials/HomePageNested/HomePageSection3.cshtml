@inherits Umbraco.Web.Mvc.UmbracoTemplatePage<IPublishedContent>
@{
    // Query all child node data
    var featureItems = Model.Content.Children.Where(x => x.IsVisible()).ToList();
}

    <!-- Start Featured Product -->
    <section class="bg-light">
        <div class="container py-5">
            <div class="row text-center py-3">
                <div class="col-lg-6 m-auto">
                    <h1 class="h1">@Umbraco.Field("homeSection3Title")</h1>
                    <p>@Umbraco.Field("homeSection3Description")</p>
                </div>
            </div>
            <div class="row">
                @foreach(var item in featureItems)
                {
                    var featureImg = item.GetPropertyValue<IPublishedContent>("featureImage");
                    
                    <div class="col-12 col-md-4 mb-4">
                        <div class="card h-100">
                            <a href="shop-single.html">
                                <img src="@(featureImg != null ? featureImg.Url : "")" class="card-img-top" alt="...">
                            </a>
                            <div class="card-body">
                                <ul class="list-unstyled d-flex justify-content-between">
                                    <li>
                                        <i class="text-warning fa fa-star"></i>
                                        <i class="text-warning fa fa-star"></i>
                                        <i class="text-warning fa fa-star"></i>
                                        <i class="text-muted fa fa-star"></i>
                                        <i class="text-muted fa fa-star"></i>
                                    </li>
                                    <li class="text-muted text-right">@item.GetPropertyValue("featurePrice")</li>
                                </ul>
                                <a href="shop-single.html" class="h2 text-decoration-none text-dark">@item.GetPropertyValue("featureName")</a>
                                <p class="card-text">@item.GetPropertyValue("featureDescription")</p>
                                <p class="text-muted">@item.GetPropertyValue("featureReview")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- End Featured Product -->