@inherits Umbraco.Web.Mvc.UmbracoViewPage<Service.ViewModels.AuthViewModel>
@using Umbraco.Web

<h2 class="my-2 d-flex justify-content-center">Login System</h2>
<hr />
@if (Members.IsLoggedIn())
{
    var currentMember = Members.GetCurrentMember();
    var displayName = currentMember != null ? currentMember.Name : Members.CurrentUserName;

    <p>Hello, <strong>@displayName</strong>!</p>
    <a href="@Url.Action("HandleLogout", "AuthSurface", new { area = "" })">Logout</a>
}else
{
    using (Html.BeginUmbracoForm<ExampleUmbraco.Controllers.AuthSurfaceController>("HandleLogin"))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("authError", true)
    
        <div class="mb-3">
            @Html.LabelFor(m => m.Email, htmlAttributes: new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "example@email.com" } })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Password, htmlAttributes: new { @class = "form-label" })
            @Html.PasswordFor(m => m.Password)
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
        
        <div class="d-flex justify-content-center mb-3">
            <button type="submit">Login</button>
            
        </div>
    }
}