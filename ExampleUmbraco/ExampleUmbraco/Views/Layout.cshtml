@inherits Umbraco.Web.Mvc.UmbracoTemplatePage
@using Umbraco.Web.Models
@using Newtonsoft.Json.Linq
@{
    // Get current url path
    string currentPath = Request.Url.AbsolutePath;

    // Handle english url
    string enUrl = currentPath;
    if (enUrl.StartsWith("/vi/", StringComparison.OrdinalIgnoreCase))
    {
        enUrl = enUrl.Substring(3);
    }
    else if (enUrl.Equals("/vi", StringComparison.OrdinalIgnoreCase))
    {
        enUrl = "/";
    }
    if (string.IsNullOrEmpty(enUrl)) { enUrl = "/"; }

    // Handle vietnamese url
    string viUrl = currentPath;
    if (!viUrl.StartsWith("/vi/", StringComparison.OrdinalIgnoreCase) && !viUrl.Equals("/vi", StringComparison.OrdinalIgnoreCase))
    {
        viUrl = viUrl == "/" ? "/vi" : "/vi" + viUrl;
    }

    // ================================================================================
    // Get data content directly on a node without depend on CurrentPage node
    var nodeLayoutContent = Umbraco.TypedContentAtRoot()
                                   .FirstOrDefault(x => x.DocumentTypeAlias == "layoutDeclaration");

    var tabIcon = nodeLayoutContent.GetPropertyValue<IPublishedContent>("tabIcon");

    // Get RAW to make UMBRACO skip CONVERTER
    var navProp = nodeLayoutContent.GetProperty("listNavigators");
    var listNavigatorsRaw = (navProp != null && navProp.DataValue != null) ? navProp.DataValue.ToString() : "";
    JArray navArray = !string.IsNullOrWhiteSpace(listNavigatorsRaw) ? JArray.Parse(listNavigatorsRaw) : new JArray();

    var prodProp = nodeLayoutContent.GetProperty("listProductsRef");
    var listProductsRefRaw = (prodProp != null && prodProp.DataValue != null) ? prodProp.DataValue.ToString() : "";
    JArray prodArray = !string.IsNullOrWhiteSpace(listProductsRefRaw) ? JArray.Parse(listProductsRefRaw) : new JArray();

    var otherProp = nodeLayoutContent.GetProperty("listOthersRef");
    var listOthersRefRaw = (otherProp != null && otherProp.DataValue != null) ? otherProp.DataValue.ToString() : "";
    JArray otherArray = !string.IsNullOrWhiteSpace(listOthersRefRaw) ? JArray.Parse(listOthersRefRaw) : new JArray();

    // Declare alias Document Type
    string tabTitle = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("tabTitle") : "";
    string mailTo = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("mailTo") : "";
    string telephone = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("telephone") : "";
    string brandName = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("brandName") : "";
    string address = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("address") : "";
    string copyRight = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("copyRight") : "";

    var titleListProductsRef = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("titleListProductsRef") : "";
    var titleListOthersRef = nodeLayoutContent != null ? nodeLayoutContent.GetPropertyValue<string>("titleListOthersRef") : "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <title>@tabTitle</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="apple-touch-icon" href="@(tabIcon != null ? tabIcon.Url : "")">
    <link rel="shortcut icon" type="image/x-icon" href="@(tabIcon != null ? tabIcon.Url : "")">

    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/templatemo.css">

    <!-- Load fonts style after rendering the layout styles -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;200;300;400;500;700;900&display=swap">
    <link rel="stylesheet" href="/css/fontawesome.min.css">
</head>

<body>
    <!-- Start Top Nav -->
    <nav class="navbar navbar-expand-lg bg-dark navbar-light d-none d-lg-block" id="templatemo_nav_top">
        <div class="container text-light">
            <div class="w-100 d-flex justify-content-between">
                <div>
                    <i class="fa fa-envelope mx-2"></i>
                    <a class="navbar-sm-brand text-light text-decoration-none" href="mailto:@mailTo.ToLower()">@mailTo.ToLower()</a>
                    <i class="fa fa-phone mx-2"></i>
                    <a class="navbar-sm-brand text-light text-decoration-none" href="tel:@telephone">@telephone</a>
                </div>
                <div>
                    <a class="text-light" href="https://fb.com/templatemo" target="_blank" rel="sponsored"><i class="fab fa-facebook-f fa-sm fa-fw me-2"></i></a>
                    <a class="text-light" href="https://www.instagram.com/" target="_blank"><i class="fab fa-instagram fa-sm fa-fw me-2"></i></a>
                    <a class="text-light" href="https://twitter.com/" target="_blank"><i class="fab fa-twitter fa-sm fa-fw me-2"></i></a>
                    <a class="text-light" href="https://www.linkedin.com/" target="_blank"><i class="fab fa-linkedin fa-sm fa-fw"></i></a>
                </div>
            </div>
        </div>
    </nav>
    <!-- Close Top Nav -->
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-light shadow">
        <div class="container d-flex justify-content-between align-items-center">

            <a class="navbar-brand text-success logo h1 align-self-center" href="/">
                @brandName
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#templatemo_main_nav" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="align-self-center collapse navbar-collapse flex-fill  d-lg-flex justify-content-lg-between" id="templatemo_main_nav">
                <div class="flex-fill">

                    @if (navArray != null && navArray.Count > 0)
                    {
                        <ul class="nav navbar-nav d-flex justify-content-between mx-lg-auto">
                            @foreach (JToken item in navArray)
                            {
                                var caption = item["caption"] != null ? item["caption"].ToString() : "";
                                var link = item["link"] != null ? item["link"].ToString() : "";
                                var isInternal = item["isInternal"] != null ? item["isInternal"].ToObject<bool>() : false;
                                var newWindow = item["newWindow"] != null ? item["newWindow"].ToObject<bool>() : false;
                                var target = newWindow ? "_blank" : "_self";

                                var finalUrl = link;
                                if (isInternal && !string.IsNullOrEmpty(link))
                                {
                                    var targetNode = Umbraco.TypedContent(link);
                                    if (targetNode != null) { finalUrl = targetNode.Url; }
                                }

                                <li class="nav-item"><a class="nav-link" href="@finalUrl" target="@target">@caption</a></li>
                            }
                        </ul>
                    }
                </div>
                
                <div class="navbar align-self-center d-flex">
                    <!-- SEARCH BAR -->
                    <div class="d-lg-none flex-sm-fill mt-3 mb-4 col-7 col-sm-auto pr-3">
                        <div class="input-group">
                            <form action="/shop/" method="get" class="modal-content modal-body border-0 p-0">
                                <input type="text" class="form-control" name="keyword" placeholder="Nhập tên xe (VD: Honda, SH...)"/>
                                <button type="submit"><i class="fa fa-fw fa-search"></i></button>
                            </form>
                        </div>

                    </div>
                    <a class="nav-icon d-none d-lg-inline" href="#" data-bs-toggle="modal" data-bs-target="#templatemo_search">
                        <i class="fa fa-fw fa-search text-dark mr-2"></i>
                    </a>
                    <!-- ======== -->
                    
                    <a class="nav-icon position-relative text-decoration-none" href="#">
                        <i class="fa fa-fw fa-cart-arrow-down text-dark mr-1"></i>
                        <span class="position-absolute top-0 left-100 translate-middle badge rounded-pill bg-light text-dark">7</span>
                    </a>
                    <a class="nav-icon position-relative text-decoration-none" href="#">
                        <i class="fa fa-fw fa-user text-dark mr-3"></i>
                        <span class="position-absolute top-0 left-100 translate-middle badge rounded-pill bg-light text-dark">+99</span>
                    </a>
                </div>
            </div>

            <div class="language-switcher" style="margin-left:10px">
                <select onchange="location = this.value;" class="form-select form-select-sm" style="width: auto; display: inline-block;">
                    <option value="@viUrl" @(currentPath.StartsWith("/vi") ? "selected" : "")>
                        vi - Tiếng Việt
                    </option>
                    <option value="@enUrl" @(!currentPath.StartsWith("/vi") ? "selected" : "")>
                        en - English
                    </option>
                </select>
            </div>

        </div>
    </nav>
    <!-- Close Header -->
    <!-- Modal -->
    <div class="modal fade bg-white" id="templatemo_search" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="w-100 pt-1 mb-5 text-right">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/shop/" method="get" class="modal-content modal-body border-0 p-0">
                <div class="input-group mb-2">
                    <input type="text" class="form-control" id="inputModalSearch" name="keyword" placeholder="Nhập tên xe (VD: Honda, SH...)" />
                    <button class="input-group-text bg-success text-light" type="submit">
                        <i class="fa fa-fw fa-search text-white"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @RenderBody()

    <!-- Start Footer -->
    <footer class="bg-dark" id="tempaltemo_footer">
        <div class="container">
            <div class="row">

                <div class="col-md-4 pt-5">
                    <h2 class="h2 text-success border-bottom pb-3 border-light logo">Zay Shop</h2>
                    <ul class="list-unstyled text-light footer-link-list">
                        <li>
                            <i class="fas fa-map-marker-alt fa-fw"></i>
                            @address
                        </li>
                        <li>
                            <i class="fa fa-phone fa-fw"></i>
                            <a class="text-decoration-none" href="tel:@telephone">@telephone</a>
                        </li>
                        <li>
                            <i class="fa fa-envelope fa-fw"></i>
                            <a class="text-decoration-none" href="mailto:@mailTo">@mailTo</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 pt-5">
                    <h2 class="h2 text-light border-bottom pb-3 border-light">@titleListProductsRef</h2>
                    @if (prodArray != null && prodArray.Count > 0)
                    {
                        <ul class="list-unstyled text-light footer-link-list">
                            @foreach (JToken item in prodArray)
                            {
                                var caption = item["caption"] != null ? item["caption"].ToString() : "";
                                var link = item["link"] != null ? item["link"].ToString() : "";
                                var isInternal = item["isInternal"] != null ? item["isInternal"].ToObject<bool>() : false;
                                var newWindow = item["newWindow"] != null ? item["newWindow"].ToObject<bool>() : false;
                                var target = newWindow ? "_blank" : "_self";

                                var finalUrl = link;
                                if (isInternal && !string.IsNullOrEmpty(link))
                                {
                                    var targetNode = Umbraco.TypedContent(link);
                                    if (targetNode != null) { finalUrl = targetNode.Url; }
                                }
                                <li><a class="text-decoration-none" href="@finalUrl" target="@target">@caption</a></li>
                            }
                        </ul>
                    }
                </div>

                <div class="col-md-4 pt-5">
                    <h2 class="h2 text-light border-bottom pb-3 border-light">@titleListOthersRef</h2>
                    @if (otherArray != null && otherArray.Count > 0)
                    {
                        <ul class="list-unstyled text-light footer-link-list">
                            @foreach (JToken item in otherArray)
                            {
                                var caption = item["caption"] != null ? item["caption"].ToString() : "";
                                var link = item["link"] != null ? item["link"].ToString() : "";
                                var isInternal = item["isInternal"] != null ? item["isInternal"].ToObject<bool>() : false;
                                var newWindow = item["newWindow"] != null ? item["newWindow"].ToObject<bool>() : false;
                                var target = newWindow ? "_blank" : "_self";

                                var finalUrl = link;
                                if (isInternal && !string.IsNullOrEmpty(link))
                                {
                                    var targetNode = Umbraco.TypedContent(link);
                                    if (targetNode != null) { finalUrl = targetNode.Url; }
                                }
                                <li><a class="text-decoration-none" href="@finalUrl" target="@target">@caption</a></li>
                            }
                        </ul>
                    }
                </div>

            </div>

            <div class="row text-light mb-4">
                <div class="col-12 mb-3">
                    <div class="w-100 my-3 border-top border-light"></div>
                </div>
                <div class="col-auto me-auto">
                    <ul class="list-inline text-left footer-icons">
                        <li class="list-inline-item border border-light rounded-circle text-center">
                            <a class="text-light text-decoration-none" target="_blank" href="http://facebook.com/"><i class="fab fa-facebook-f fa-lg fa-fw"></i></a>
                        </li>
                        <li class="list-inline-item border border-light rounded-circle text-center">
                            <a class="text-light text-decoration-none" target="_blank" href="https://www.instagram.com/"><i class="fab fa-instagram fa-lg fa-fw"></i></a>
                        </li>
                        <li class="list-inline-item border border-light rounded-circle text-center">
                            <a class="text-light text-decoration-none" target="_blank" href="https://twitter.com/"><i class="fab fa-twitter fa-lg fa-fw"></i></a>
                        </li>
                        <li class="list-inline-item border border-light rounded-circle text-center">
                            <a class="text-light text-decoration-none" target="_blank" href="https://www.linkedin.com/"><i class="fab fa-linkedin fa-lg fa-fw"></i></a>
                        </li>
                    </ul>
                </div>
                <div class="col-auto">
                    <label class="sr-only" for="subscribeEmail">Email address</label>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control bg-dark border-light" id="subscribeEmail" placeholder="Email address">
                        <div class="input-group-text btn-success text-light">Subscribe</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="w-100 bg-black py-3">
            <div class="container">
                <div class="row pt-2">
                    <div class="col-12">
                        <p class="text-left text-light">
                            Copyright &copy; @copyRight
                            | Designed by <a rel="sponsored" href="https://templatemo.com" target="_blank">TemplateMo</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </footer>
    <!-- End Footer -->
    <!-- Start Script -->
    <script src="/scripts/jquery-1.11.0.min.js"></script>
    <script src="/scripts/jquery-migrate-1.2.1.min.js"></script>
    <script src="/scripts/bootstrap.bundle.min.js"></script>
    <script src="/scripts/templatemo.js"></script>
    <!-- End Script -->
</body>

</html>