@inherits Umbraco.Web.Mvc.UmbracoTemplatePage
@{
	Layout = "Layout.cshtml";
	
	var heroImage = Model.Content.GetPropertyValue<IPublishedContent>("aboutpageHeroImage");
	var serviceList = Model.Content.GetPropertyValue<IEnumerable<string>>("aboutpageServiceList");
	
	var brandImgs = Model.Content.GetPropertyValue<IEnumerable<IPublishedContent>>("aboutpageBrandImages");
}

<section class="bg-success py-5">
    <div class="container">
        <div class="row align-items-center py-5">
            <div class="col-md-8 text-white">
                <h1>@Umbraco.Field("aboutpageTitle")</h1>
                <p>@Umbraco.Field("aboutpageDescription")</p>
            </div>
            <div class="col-md-4">
                @if (heroImage != null)
                {
                    <img src="@heroImage.Url" alt="About Hero">
                }
            </div>
        </div>
    </div>
</section>
<!-- Close Banner -->

<!-- Start Section -->
<section class="container py-5">
    <div class="row text-center pt-5 pb-3">
        <div class="col-lg-6 m-auto">
            <h1 class="h1">@Umbraco.Field("aboutpageServiceTitle")</h1>
            <p>@Umbraco.Field("aboutpageServiceDescription")</p>
        </div>
    </div>
    <div class="row">

    @if (serviceList != null && serviceList.Any())
    {   
        int iconNum = 1;
        foreach (var item in serviceList)
        {
            <div class="col-md-6 col-lg-3 pb-5">
                <div class="h-100 py-5 services-icon-wap shadow">
                    <div class="h1 text-success text-center">
                        @if (iconNum == 1) { <i class="fa fa-truck fa-lg"></i> }
                        else if (iconNum == 2) { <i class="fas fa-exchange-alt"></i> }
                        else if (iconNum == 3) { <i class="fa fa-percent"></i> }
                        else { <i class="fa fa-user"></i> }
                    </div>
                    <h2 class="h5 mt-4 text-center">@item</h2>
                </div>
            </div>
            iconNum++;
        }
    }
    </div>
</section>
<!-- End Section -->

<!-- Start Brands -->
<section class="bg-light py-5">
    <div class="container my-4">
        <div class="row text-center py-3">
            <div class="col-lg-6 m-auto">
                <h1 class="h1">@Umbraco.Field("aboutpageBrandTitle")</h1>
                <p>@Umbraco.Field("aboutpageBrandDescription")</p>
            </div>
            <div class="col-lg-9 m-auto tempaltemo-carousel">
                <div class="row d-flex flex-row">
                    <!--Controls-->
                    <div class="col-1 align-self-center">
                        <a class="h1" href="#templatemo-slide-brand" role="button" data-bs-slide="prev">
                            <i class="text-light fas fa-chevron-left"></i>
                        </a>
                    </div>
                    <!--End Controls-->

                    <!--Carousel Wrapper-->
                    <div class="col">
                        <div class="carousel slide carousel-multi-item pt-2 pt-md-0" id="templatemo-slide-brand" data-bs-ride="carousel">
                            <!--Slides-->
                            <div class="carousel-inner product-links-wap" role="listbox">

                                <!--First slide-->
                                @if (brandImgs != null && brandImgs.Any())
                                {
                                <div class="carousel-item active">
                                    <div class="row">
                                        @foreach (var image in brandImgs)
                                        {
                                        <div class="col-3 p-md-5">
                                            <a href="#"><img class="img-fluid brand-img" src="@image.Url" alt="@image.Name" /></a>
                                        </div>
                                        }
                                    </div>
                                </div>
                                }
                                <!--End First slide-->
                                <!--Second slide-->
                                @if (brandImgs != null && brandImgs.Any())
                                {
                                <div class="carousel-item">
                                    <div class="row">
                                        @foreach (var image in brandImgs)
                                        {
                                        <div class="col-3 p-md-5">
                                            <a href="#"><img class="img-fluid brand-img" src="@image.Url" alt="@image.Name" /></a>
                                        </div>
                                        }
                                    </div>
                                </div>
                                }
                                <!--End Second slide-->

                            </div>
                            <!--End Slides-->
                        </div>
                    </div>
                    <!--End Carousel Wrapper-->

                    <!--Controls-->
                    <div class="col-1 align-self-center">
                        <a class="h1" href="#templatemo-slide-brand" role="button" data-bs-slide="next">
                            <i class="text-light fas fa-chevron-right"></i>
                        </a>
                    </div>
                    <!--End Controls-->
                </div>
            </div>
        </div>
    </div>
</section>
<!--End Brands-->